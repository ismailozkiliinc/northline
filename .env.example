# Environment variables — copy to `.env.local` (never commit real secrets)
# cp .env.example .env.local

# ── Public (browser-safe) ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://niscraft.com
NEXT_PUBLIC_CONTACT_EMAIL=YOUR_CONTACT_EMAIL
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_BEHANCE=

# ── Supabase (optional — without these, leads save under `.data/`) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend — REQUIRED in production for contact email delivery ──────────────
# 1) https://resend.com → Domains → add + verify niscraft.com (SPF/DKIM)
# 2) https://resend.com/api-keys → create key
# RESEND_FROM requires a Resend-verified domain (do not use until verified)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=NISCRAFT <hello@niscraft.com>
LEAD_NOTIFY_EMAIL=YOUR_LEAD_EMAIL

# ── Admin — REQUIRED in production (no insecure defaults) ───────────────────
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
# Generate locally (do NOT commit the output):
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=YOUR_RANDOM_SECRET
ADMIN_ROLE=super_admin
